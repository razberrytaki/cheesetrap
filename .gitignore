# Local deployment config, raw evidence, credentials, and temporary data.
.local/
secrets/
.env
.env.*
!.env.example
!.env.*.example
credentials.json
credentials.yaml
credentials.yml
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519
id_ecdsa
id_dsa
.aws/
.ssh/
.oci/

# Public templates must contain placeholders only; no blanket testdata exception.
# Certificate/key fixtures, if needed, require explicit review before git add -f.

# Build and analysis outputs.
/bin/
/build/
/dist/
/coverage/
/cheesetrap
*.test
.DS_Store

# Deliberately do not ignore *.jsonl, *.log, or testdata/: public, sanitized
# fixtures must remain trackable. Keep raw evidence and keys in the dirs above.

# React UI dependencies and generated release assets.
/web/node_modules/
/internal/ui/dist/

# Python installation/test helper bytecode.
**/__pycache__/
*.pyc

