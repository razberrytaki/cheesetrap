{
  "name": "cheesetrap-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "generate:api": "orval --config orval.config.ts && node scripts/generate-api-compat.mjs",
    "pretest": "node ../scripts/test-e2e-reporter.mjs && node --test ../scripts/test-ui-test-identities.mjs",
    "test": "vitest",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "../scripts/test-e2e.sh",
    "test:api": "orval --config orval.fixtures.config.ts --project wire && orval --config orval.fixtures.config.ts --project converted && node ../experiments/orval/compare-types.mjs && node --test scripts/generate-api-compat.test.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "orval": "8.46.0"
  }
}
